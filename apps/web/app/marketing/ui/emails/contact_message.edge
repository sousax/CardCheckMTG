@email.layout({ title, preview: message })
  <mj-section background-color="#ffffff" padding="36px 40px 8px">
    <mj-column>
      <mj-text
        padding="0 0 18px 0"
        font-size="24px"
        font-weight="800"
        line-height="1.2"
        color="#141820"
        letter-spacing="-0.02em"
      >
        {{ title }}
      </mj-text>
      <mj-text padding="0 0 4px 0" font-size="14.5px" line-height="1.6" color="#3A4150">
        <strong>{{ name }}</strong>
        &lt;{{ email }}&gt;
      </mj-text>
    </mj-column>
  </mj-section>

  <mj-section background-color="#ffffff" padding="0 40px 36px">
    <mj-column>
      <mj-text padding="0" font-size="16px" line-height="1.6" color="#141820" css-class="pre-line">
        {{ message }}
      </mj-text>
    </mj-column>
  </mj-section>
@end
