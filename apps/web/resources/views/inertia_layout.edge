<!DOCTYPE html>
<html lang="{{ i18n?.locale ?? 'pt' }}">

  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {{-- Selo CL. Served from public/ so the manifest and browsers get stable URLs. --}}
    <link rel="icon" href="/favicon.ico" sizes="48x48">
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <link rel="manifest" href="/site.webmanifest">
    <meta name="theme-color" content="#ef4444">

    {{-- Card art is served from Scryfall's CDN; open the connection before the first <img>. --}}
    <link rel="preconnect" href="https://cards.scryfall.io">

    <meta name="description" content="Cole sua decklist de Magic: The Gathering, marque as cartas que você já tem e veja o que falta comprar." />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="MTG CardList" />
    <meta property="og:description" content="Checklist de compras para decks de Magic: The Gathering." />

    <title data-inertia>
      MTG CardList
    </title>

    {{-- Apply the saved palette before first paint so SSR pages don't flash the default one. --}}
    <script>
      (function () {
        var palette = 'brasa'
        try { palette = localStorage.getItem('cardlist-palette') || 'brasa' } catch (e) {}
        document.documentElement.dataset.palette = palette
        document.documentElement.classList.add(palette === 'linho' ? 'light' : 'dark')
      })()
    </script>

    {{--
      GA4 loads only after cookie consent (LGPD); the banner calls load() on "Aceitar".
      Enhanced measurement tracks Inertia's pushState navigations on its own.
      Outside production the banner still shows, but load() never fetches gtag.
    --}}
    @if(config('app.gaMeasurementId'))
      <script>
        (function () {
          var id = '{{ config('app.gaMeasurementId') }}'
          var enabled = {{ app.inProduction }}
          window.cardlistAnalytics = {
            load: function () {
              if (!enabled || window.gtag) return
              var script = document.createElement('script')
              script.async = true
              script.src = 'https://www.googletagmanager.com/gtag/js?id=' + id
              document.head.appendChild(script)
              window.dataLayer = window.dataLayer || []
              window.gtag = function () { window.dataLayer.push(arguments) }
              window.gtag('js', new Date())
              window.gtag('config', id)
            },
          }
          try {
            if (localStorage.getItem('cardlist-cookie-consent') === 'granted') window.cardlistAnalytics.load()
          } catch (e) {}
        })()
      </script>
    @end

    @stack('dumper')
    @viteReactRefresh()
    @inertiaHead()
    @vite(['app/core/ui/app/app.tsx'])
  </head>

  <body class="min-h-screen w-screen font-sans">
    @inertia()
  </body>

</html>
